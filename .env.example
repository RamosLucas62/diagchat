NODE_ENV=production
PORT=3000
APP_URL=https://seu-dominio.com.br
DATABASE_URL=postgresql://postgres.PROJECT:SENHA@HOST:5432/postgres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Gere: openssl rand -hex 32. Guarde um backup seguro; não troque após cadastrar credenciais.
ENCRYPTION_KEY=
# Escolha uma versão da Graph API suportada pelo seu aplicativo Meta.
META_GRAPH_VERSION=v25.0
RESEND_API_KEY=
RESEND_FROM=Financeiro <financeiro@seu-dominio.com.br>
DEMO_MODE=false
WORKER_CONCURRENCY=16
# Evolution v2: instância usada somente para avisos em grupos
EVOLUTION_URL=https://evolution.seu-dominio.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Asaas: cadastre pagadores e webhook manualmente no painel do Asaas.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Token independente da API key, com 32 a 255 caracteres, igual ao cadastrado no webhook.
ASAAS_WEBHOOK_TOKEN=
# Somente se os PDFs retornados pelo Asaas usarem outro domínio HTTPS (nomes exatos separados por vírgula).
ASAAS_DOCUMENT_HOSTS=
