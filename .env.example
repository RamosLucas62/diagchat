NODE_ENV=production
PORT=3000
APP_URL=https://seu-dominio.com.br
DATABASE_URL=postgresql://postgres.PROJECT:SENHA@HOST:5432/postgres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Gere: openssl rand -hex 32. Guarde um backup seguro; não troque após cadastrar credenciais.
ENCRYPTION_KEY=
# Escolha uma versão da Graph API suportada pelo seu aplicativo Meta.
META_GRAPH_VERSION=v25.0
RESEND_API_KEY=
RESEND_FROM=Financeiro <financeiro@seu-dominio.com.br>
DEMO_MODE=false
WORKER_CONCURRENCY=16
# Evolution v2: instância usada somente para avisos em grupos
EVOLUTION_URL=https://evolution.seu-dominio.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
